{
  "name": "software-fabrik",
  "version": "0.17.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "src/factory",
    "src/orchestrator",
    "src/worker",
    "src/shared"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test --test-concurrency=2 \"tests/**/*.test.mjs\" \"tests/**/*.test.cjs\"",
    "dev:fleet": "node scripts/fleet.mjs",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.webviews.json",
    "dev:factory": "node scripts/factory-fleet.mjs",
    "check": "npm run check:fast && npm test",
    "audit:dependencies": "npm audit --audit-level=low",
    "release:package": "node scripts/release/package.mjs",
    "release:build": "npm run readme:check && npm run changelog:check && npm run build && npm run storybook:ci && npm run release:package && npm run release:storybook && npm run release:readme",
    "storybook": "npm run storybook:generate && storybook dev -p 6006 --no-open",
    "storybook:generate": "node scripts/storybook/generate.mjs",
    "storybook:build": "npm run storybook:generate && storybook build --disable-telemetry",
    "storybook:capture": "node scripts/storybook/capture.mjs",
    "storybook:ci": "npm run storybook:build && npm run storybook:capture",
    "release:storybook": "node scripts/release/storybook-package.mjs",
    "changelog:check": "node scripts/release/changelog.mjs check",
    "changelog:notes": "node scripts/release/changelog.mjs notes",
    "mutation": "node scripts/mutation/run.mjs",
    "mutation:release": "node scripts/mutation/run.mjs --advisory",
    "mutation:contracts": "node scripts/mutation/build.mjs && node --test \"scripts/mutation/suites/*.test.mjs\" \".mutation-build/tests/*.test.mjs\"",
    "lint:oxlint": "oxlint --deny-warnings src scripts storybook .storybook tests werk.mjs worker.mjs stryker.config.mjs",
    "analyze:fallow": "node scripts/quality/fallow.mjs",
    "check:architecture": "node --test tests/architecture/architecture-boundaries.test.mjs tests/architecture/dependency-graph.test.mjs",
    "check:fast": "npm run readme:check && npm run check:loc && npm run lint:oxlint && npm run analyze:fallow && npm run check:architecture && npm run typecheck && npm run typecheck:tests",
    "check:loc": "node scripts/quality/loc.mjs",
    "typecheck:tests": "node scripts/quality/typecheck-tests.mjs",
    "readme:generate": "node scripts/storybook/readme-source.mjs generate",
    "readme:check": "node scripts/storybook/readme-source.mjs check",
    "release:readme": "node scripts/release/readme-package.mjs",
    "diagnostics:provider": "node scripts/runtime/provider-diagnostics.mjs",
    "benchmark:intake": "node scripts/quality/local-intake-benchmark.mjs",
    "pilot:provider": "node scripts/runtime/provider-pilot.mjs",
    "acceptance:worker-home": "node tests/worker/worker-home-browser.mjs"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.143",
    "@nuxt/ui": "4.11.3",
    "@types/node": "24.0.0",
    "@vitejs/plugin-vue": "6.0.4",
    "entities": "7.0.1",
    "fflate": "0.8.3",
    "tailwindcss": "4.2.2",
    "tar": "7.5.22",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vue": "3.5.44",
    "vue-router": "4.6.4",
    "vue-tsc": "3.2.6",
    "@storybook/vue3-vite": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "storybook": "10.6.2",
    "playwright": "1.64.1",
    "esbuild": "0.28.2",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/tap-runner": "10.0.0",
    "oxlint": "1.88.0",
    "fallow": "3.35.0",
    "@vue/compiler-sfc": "3.5.44",
    "@vue/server-renderer": "3.5.44"
  },
  "dependencies": {
    "undici": "8.12.3",
    "yaml": "2.9.1",
    "marked": "17.0.6"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "typed-rest-client": {
      "qs": "6.16.1"
    }
  }
}
