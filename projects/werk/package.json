{
  "name": "software-fabrik",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "src/factory",
    "src/orchestrator",
    "src/worker",
    "src/shared"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test --test-concurrency=2 \"tests/**/*.test.mjs\" \"tests/**/*.test.cjs\"",
    "dev:fleet": "node scripts/fleet.mjs",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p src/worker/webview/tsconfig.json",
    "dev:factory": "node scripts/factory-fleet.mjs",
    "check": "npm run typecheck && npm test",
    "audit:dependencies": "npm audit --audit-level=low",
    "release:package": "node scripts/release/package.mjs",
    "release:build": "npm run build && npm run release:package"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.143",
    "@nuxt/ui": "4.11.3",
    "@types/node": "24.0.0",
    "@vitejs/plugin-vue": "6.0.4",
    "fflate": "0.8.3",
    "tailwindcss": "4.2.2",
    "tar": "7.5.22",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vue": "3.5.44",
    "vue-router": "4.6.4",
    "vue-tsc": "3.2.6"
  },
  "dependencies": {
    "undici": "8.11.2",
    "yaml": "2.9.1"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
